{
  // Aprimo DAM CSV export - configuration.
  // Comments are allowed: the loader is configured to skip them.
  // Precedence: this file < environment variables < command-line switches.

  "Aprimo": {
    // Subdomain of your Aprimo DAM URL. Derives both endpoints below:
    //   API   -> https://{tenant}.dam.aprimo.com/api/core
    //   Token -> https://{tenant}.aprimo.com/login/connect/token   (note: no ".dam")
    // REQUIRED. Set this before first run, or pass --tenant.
    //
    // To confirm the derived endpoints for your tenant, fetch its OpenID discovery
    // document, which lists the real token_endpoint, grant types and scopes:
    //   https://{tenant}.aprimo.com/login/.well-known/openid-configuration
    // Note the .dam host returns 404 there - the identity server is on the plain host.
    "Tenant": "",

    // Set these via APRIMO_CLIENT_ID / APRIMO_CLIENT_SECRET instead of committing them.
    "ClientId": "",
    "ClientSecret": "",

    "Scope": "api",
    "ClientAuthStyle": "Basic",

    // Renew this many seconds before expiry. Must exceed Source.RequestTimeoutSeconds
    // (120), or a request can outlive its own token. Check the Access Token Lifetime on
    // your registration: for a 10-minute token, 180 renews at the 7-minute mark. Raise
    // this if your tokens are shorter-lived than that.
    "RefreshSkewSeconds": 180,

    "ApiVersion": "1",

    // "languages" header: a single language ID, a comma-separated list, or "*" for all.
    // The API accepts IDs only - not names like "English (US English)".
    //
    // "*" returns every locale, joining a multi-language field's values into one cell.
    //
    // To scope to one language, run --sample: it prints every language ID the tenant
    // actually returns alongside a sample value, so the one you want is identifiable by
    // reading it. Then list it here.
    //
    // Include the language-neutral ID 00000000000000000000000000000000 alongside it.
    // Single-language fields use that ID, and in practice they are often the majority -
    // filtering to one real language alone can silently drop most of the metadata. e.g.
    //   "Languages": "<your-language-id>,00000000000000000000000000000000"
    //
    // A wrong ID is caught on page 1 rather than producing blank columns.
    "Languages": "*"
  },

  "Source": {
    // Search  -> POST /search/records  (supports search expressions + Keyset paging)
    // Records -> GET  /records         (supports a filter expression)
    "Mode": "Search",

    // Null = no content-type or status filter, i.e. every record.
    //
    // IMPORTANT: POST /search/records rejects an empty searchExpression outright, so in
    // Search mode something must supply one. With --daily / --since the delta window does
    // (ModifiedOn >= X AND ModifiedOn < Y), which is the normal path. For an unfiltered
    // full export of every record, use --mode Records (GET /records needs no expression).
    //
    // To narrow: operators = <> > >= < <= CONTAINS in; logical AND OR NOT.
    // Reference metadata fields with FieldName("Brand") or FieldId("guid").
    //   e.g. "ContentType = 'Asset' AND Status = 'Released'"
    "SearchExpression": null,

    // A stable sort is required for correct paging. Ascending; prefix with "-" for
    // descending, though descending is riskier on a live system (newly modified
    // records jump to page 1 and shift every offset behind them).
    "Sort": "ModifiedOn",

    // Sub-resources to embed. Without this, those record properties come back null.
    // Include createdby/modifiedby only if your column list maps them - each one adds
    // to the response size on every record.
    "SelectRecord": "fields,masterfilelatestversion,createdby,modifiedby",

    // Leave null to have select-record-fields derived from the loaded column list,
    // which meaningfully shrinks each response on wide schemas.
    "SelectRecordFields": null,
    "AutoDeriveSelectRecordFields": true,

    // Fail on page 1 if metadata fields are missing rather than writing blank columns.
    "VerifyFieldsOnFirstPage": true,

    "Paging": {
      // Offset     -> skip/take        simple; may hit a deep-paging ceiling
      // PageNumber -> page/pageSize    same caveat
      // Keyset     -> watermark in the search expression; scales to millions
      "Mode": "Offset",

      // API maximum is 1000.
      "PageSize": 1000,

      // Keyset only, and it overrides Sort above while Keyset is active.
      // Keep this immutable: if a record is edited mid-export, a ModifiedOn watermark
      // moves past itself and that record gets exported twice. CreatedOn never moves.
      "KeysetProperty": "CreatedOn",

      "MaxPages": 0
    },

    // Incremental export. Drive it with --daily (= --since last) or --since <spec>.
    "Delta": {
      // Compared property. ModifiedOn = "what changed"; CreatedOn = "what is new".
      "Property": "ModifiedOn",

      // Minutes of deliberate re-read when resuming, to absorb clock skew between the
      // API's ModifiedOn stamp and our own clock. Costs a few duplicate rows per run;
      // the alternative is silently dropping records. Set 0 for exact adjacency.
      "OverlapMinutes": 5,

      // High-water mark file, relative to Output.Directory. Keyed by tenant + query.
      "StateFile": "delta-state.json",

      "WarnIfWindowExceedsDays": 7
    },

    "Retry": {
      "MaxAttempts": 5,
      "InitialBackoffSeconds": 1.0,
      "MaxBackoffSeconds": 60.0,
      "BackoffMultiplier": 2.0,
      "RespectRetryAfter": true
    },

    "RequestTimeoutSeconds": 120
  },

  "Throttle": {
    // Requests per second. Fractional allowed (0.5 = one request every 2s). 0 = unlimited.
    "RequestsPerSecond": 5.0,

    // Token-bucket depth: how many requests may fire back-to-back. 1 = even spacing.
    "Burst": 1,

    "MaxConcurrentRequests": 1
  },

  "Output": {
    "Directory": "./export",
    "FilePrefix": "aprimo-records",
    "Delimiter": ",",
    "WriteByteOrderMark": true,
    "NewLine": "CRLF",
    "MultiValueSeparator": "|",
    "SanitizeFormulas": true,
    "WriteBufferBytes": 1048576,
    "Overwrite": false
  },

  "Limits": {
    // Rows per CSV file before rolling to the next part. 0 = never roll.
    "MaxRecordsPerFile": 1000000,

    // Total row cap across all files. 0 = unlimited. Set this for demos.
    "MaxTotalRecords": 0,

    "EnableCheckpoint": true
  },

  // CSV columns come from an external file so the field set can be edited without
  // touching the rest of this config. Resolved relative to the current directory,
  // then to the directory holding the executable.
  //
  // Format: field names separated by newlines, commas, semicolons or tabs - mix freely.
  //   Brand                      -> column "Brand",    path "field:Brand"
  //   Alt Text                   -> column "Alt_Text", path "field:Alt Text"
  //   RecordId => id             -> explicit mapping for a record property
  //   #  or  //                  -> comment (only at line start or after whitespace,
  //                                 since real field names can contain '#')
  //
  // An Aprimo Data Exports schema XML file is also accepted here, read directly.
  // Override per run with --fields-file / -f.
  "FieldsFile": "fields.txt",

  // Inline fallback, used only when FieldsFile is null or empty.
  "Fields": []
}
